FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        iproute2 iputils-ping curl ca-certificates procps tcpdump nftables iptables \
    && rm -rf /var/lib/apt/lists/*
COPY wardkeep-server /usr/local/bin/wardkeep-server
COPY wardkeep /usr/local/bin/wardkeep
