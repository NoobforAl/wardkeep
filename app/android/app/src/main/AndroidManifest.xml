<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The VPN itself: connections to the servers, and the UI's to the in-process core on 127.0.0.1. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The core follows the phone's networks (Wi-Fi, mobile data) to send the tunnel out of the right one
         and to reconnect when it changes (CorePlatform: interfaces, default-network monitor). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- ConnectivityManager.requestNetwork: the monitor that tracks the best non-VPN network. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- The VPN service keeps running in the foreground, with its notification, while connected. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: the foreground service's type ("specialUse", subtype vpn; see the service below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: the VPN status notification (speed, Reconnect, Disconnect), "Connection lost", and
         failures the app could not handle; asked for in the app. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Split tunneling: the picker of apps that use (or skip) the VPN lists the installed apps. The list
         never leaves the device. A permitted use for VPN apps; the APKs are distributed outside Play. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- The QR scanner (flutter_zxing on the camera plugin); asked for when the scan screen opens.
         The camera plugin also declares the microphone and storage, for videos and photos the app never
         records or saves: removed (the build adds READ_EXTERNAL_STORAGE for it too).
         A phone without a camera can still install the app (QR import is optional). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" tools:replace="android:required" />

    <!-- No android:appCategory: none of Android's categories (game, audio, video, image, social, news,
         maps, productivity, accessibility) fits a VPN client. -->
    <application
        android:allowBackup="false"
        android:label="Wardkeep"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Share links (vless://, trojan://, …) open Wardkeep, which imports them. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vless" />
                <data android:scheme="vmess" />
                <data android:scheme="trojan" />
                <data android:scheme="ss" />
                <data android:scheme="hysteria2" />
                <data android:scheme="hy2" />
                <data android:scheme="hysteria" />
                <data android:scheme="tuic" />
                <data android:scheme="wireguard" />
                <data android:scheme="awg" />
                <data android:scheme="anytls" />
                <data android:scheme="nordvpn" />
                <data android:scheme="naive+https" />
            </intent-filter>
            <!-- Config files by their type (what well-known VPN apps and file managers send). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/x-openvpn-profile" />
                <data android:mimeType="application/x-wireguard-profile" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/yaml" />
            </intent-filter>
            <!-- Config files by their name, when the type is a generic one (.ovpn, .conf, .json, .yaml, .txt). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:host="*" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\..*\\.ovpn" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.ovpn" />
                <data android:pathPattern=".*\\.conf" />
                <data android:pathPattern=".*\\..*\\.conf" />
                <data android:pathPattern=".*\\..*\\..*\\.conf" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.conf" />
                <data android:pathPattern=".*\\.json" />
                <data android:pathPattern=".*\\..*\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\.json" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.json" />
                <data android:pathPattern=".*\\.yaml" />
                <data android:pathPattern=".*\\..*\\.yaml" />
                <data android:pathPattern=".*\\..*\\..*\\.yaml" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.yaml" />
                <data android:pathPattern=".*\\.yml" />
                <data android:pathPattern=".*\\..*\\.yml" />
                <data android:pathPattern=".*\\..*\\..*\\.yml" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.yml" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\.txt" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.txt" />
            </intent-filter>
            <!-- "Share" from another app: a link, some text, or a config file. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/x-openvpn-profile" />
                <data android:mimeType="application/x-wireguard-profile" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/x-yaml" />
                <data android:mimeType="text/yaml" />
                <data android:mimeType="application/yaml" />
            </intent-filter>
        </activity>
        <service
            android:name=".OmnitunVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>
        <!-- image_picker (pulled in by flutter_zxing, unused here) asks Google Play services for its
             photo picker backport: removed, the app has no Google components. -->
        <service
            android:name="com.google.android.gms.metadata.ModuleDependencies"
            tools:node="remove" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
