<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app runs in the macOS sandbox (Flutter's default); the keys below open only what it needs. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Debug and profile builds only: the Dart VM compiles code at run time. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Outgoing connections: the UI talks to its core over TCP on 127.0.0.1, and the core to the servers. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Debug and profile builds only: Flutter's tools (the Dart VM service) listen on a local port. -->
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
